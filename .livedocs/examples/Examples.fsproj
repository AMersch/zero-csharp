<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FsLiveDocs needs at least one F# project to build a site. The site is C# only,
    so this one is empty. Its own Directory.Build.props keeps the repository's
    (zerocore, no standard library) away from it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Empty.fs" />
  </ItemGroup>
</Project>
