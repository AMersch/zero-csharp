{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-all",
            "type": "shell",
            "command": "./build.sh",
            "windows": {
                "command": "powershell",
                "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-minimal",
            "type": "shell",
            "command": "./build.sh Minimal",
            "windows": { "command": "powershell -ExecutionPolicy Bypass -File build.ps1 Minimal" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-tiny",
            "type": "shell",
            "command": "./build.sh Tiny",
            "windows": { "command": "powershell -ExecutionPolicy Bypass -File build.ps1 Tiny" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-arena",
            "type": "shell",
            "command": "./build.sh Arena",
            "windows": { "command": "powershell -ExecutionPolicy Bypass -File build.ps1 Arena" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-collections",
            "type": "shell",
            "command": "./build.sh Collections",
            "windows": { "command": "powershell -ExecutionPolicy Bypass -File build.ps1 Collections" },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-virtualtest",
            "type": "shell",
            "command": "./build.sh VirtualTest",
            "windows": { "command": "powershell -ExecutionPolicy Bypass -File build.ps1 VirtualTest" },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
