<Project>
  <!--
    Editor support only: these .csproj files give VS Code (C# Dev Kit) and other
    IDEs IntelliSense that matches bflat's zero mode. bflat ignores them; build
    with ./build.sh.

    Each project compiles against zerocore/ (this repo's core library) instead
    of .NET's, with the same C# 15 settings build.sh passes to bflat. Nothing
    outside the repo is needed, not even bflat.
  -->
  <PropertyGroup>
    <!-- Several projects share samples/, so each gets its own obj/ folder. -->
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>obj/$(MSBuildProjectName)/bin/</BaseOutputPath>

    <TargetFramework>net10.0</TargetFramework>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost>false</UseAppHost>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Projects list their files explicitly, matching what build.sh compiles. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
