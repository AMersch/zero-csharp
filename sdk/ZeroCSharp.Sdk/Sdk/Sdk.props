<!--
  ZeroCSharp.Sdk: zero-mode C# projects. <Project Sdk="ZeroCSharp.Sdk/0.7.0">.

  A project gets a target framework of its own, ZeroFramework (zero03, in
  version.props), and compiles against zerocore (the core library,
  System.Private.CoreLib) and lib/ (BflatLib) instead of .NET's libraries.
  NuGet then refuses ordinary .NET packages, and packages of zero libraries
  built for another framework, with NU1202.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ZeroSdkRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</ZeroSdkRoot>
    <ZeroSdkTfm>$(ZeroFramework)</ZeroSdkTfm>

    <!-- NuGet reads a framework name it doesn't know as name + version 0.0,
         so the version is part of the name. -->
    <TargetFramework>$(ZeroSdkTfm)</TargetFramework>
    <!-- A Directory.Build.props of the repository around the project may set
         these for its .NET projects; a zero project has one framework and
         none of .NET's global usings. -->
    <TargetFrameworks></TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFrameworkIdentifier>$(ZeroSdkTfm)</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v0.0</TargetFrameworkVersion>
    <TargetFrameworkMoniker>$(ZeroSdkTfm),Version=v0.0</TargetFrameworkMoniker>

    <!-- No .NET: zerocore and lib/ are the whole framework. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <!-- zerocore has no assembly-info or target-framework attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- The language as build.sh compiles it. -->
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A library's IL is what programs compile from: optimize it, as build.sh's -O does. -->
    <Optimize>true</Optimize>

    <!-- The compiler's output is IL, always a .dll: the native program built
         from the same sources takes the plain name (or .exe for Windows). -->
    <TargetExt>.dll</TargetExt>
    <UseAppHost>false</UseAppHost>

    <!-- The native step (Sdk.targets). The host is the machine running the
         build: Linux x64 and arm64, and Windows x64. -->
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">win-x64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">osx-arm64</ZeroHostRid>
    <!-- linux-x64, linux-arm64, win-x64, osx-arm64, or uefi-x64 and uefi-arm64
         (a program the firmware starts, no operating system); the host's own
         by default. A chosen
         one (here: on the command line or in Directory.Build.props) gets an
         output folder of its own, see Sdk.targets. -->
    <ZeroTargetChosen Condition="'$(ZeroTarget)' != ''">true</ZeroTargetChosen>
    <ZeroTarget Condition="'$(ZeroTarget)' == ''">$(ZeroHostRid)</ZeroTarget>
    <!-- None (-O0), Speed (bflat's default) or Size (-Os). Debug builds aren't
         optimized, so a debugger stops on every line and sees every local;
         other configurations are. (The IL above is optimized either way.) -->
    <ZeroOptimizeFor Condition="'$(ZeroOptimizeFor)' == '' and '$(Configuration)' == 'Debug'">None</ZeroOptimizeFor>
    <ZeroOptimizeFor Condition="'$(ZeroOptimizeFor)' == ''">Speed</ZeroOptimizeFor>
    <!-- dotnet publish builds Release, as it does for .NET 8 and later (which
         decide by the target framework, and don't know this one). -->
    <PublishRelease Condition="'$(PublishRelease)' == ''">true</PublishRelease>
    <!-- ZeroDllImports: more libraries whose [DllImport]s are bound when the
         program is linked, besides libc and libm.so.6, which always are. -->
    <!-- ZeroInstructionSet: passed to bflat as -m (x86-64-v3, dotprod, ...). -->

    <!-- dotnet pack: the dll goes to lib/<framework>/ by a target in Sdk.targets,
         because NuGet's pack rejects build output for a framework it doesn't know. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5103;NU5128</NoWarn>
  </PropertyGroup>
</Project>
