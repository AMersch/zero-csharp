<!-- Packs dotnet new zero, zerolib, zerollama, zerosdl, zeropico and zerogpu (content/), with the SDK
     version filled in (obj/content). zerollama's Program.cs is samples/Llama.cs
     (sdk/pack.sh puts it in obj/zerollama). The program templates also get
     vscode/ as their .vscode folder, for debugging in VS Code. -->
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../version.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>ZeroCSharp.Templates</PackageId>
    <Version>$(ZeroSdkVersion)</Version>
    <PackageType>Template</PackageType>
    <Authors>Zero C# contributors</Authors>
    <Description>dotnet new zero (a native program), zerolib (a library), zerollama (a storyteller with a small language model), zerosdl (a game window with SDL 3), zeropico (a Raspberry Pi Pico 2 program) and zerogpu (C# kernels on an Apple Silicon Mac's GPU) for zero-mode C#: C# compiled to small native programs with no .NET runtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://onurgumus.github.io/zero-csharp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OnurGumus/zero-csharp</RepositoryUrl>
    <PackageTags>dotnet-new;templates;csharp;native;zero</PackageTags>
    <ZeroContent>$(BaseIntermediateOutputPath)content/</ZeroContent>
  </PropertyGroup>
  <!-- The content with the SDK version filled in. -->
  <Target Name="ZeroStageContent" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_ZeroTemplateFile Include="content/**" />
    </ItemGroup>
    <RemoveDir Directories="$(ZeroContent)" />
    <Copy SourceFiles="@(_ZeroTemplateFile)" DestinationFiles="@(_ZeroTemplateFile->'$(ZeroContent)%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(ZeroContent)%(_ZeroTemplateFile.RecursiveDir)%(_ZeroTemplateFile.Filename)%(_ZeroTemplateFile.Extension)"
                      Lines="$([System.IO.File]::ReadAllText('%(_ZeroTemplateFile.FullPath)').Replace('@ZERO_SDK_VERSION@', '$(ZeroSdkVersion)'))"
                      Overwrite="true" Condition="'%(_ZeroTemplateFile.Extension)' == '.csproj' or '%(_ZeroTemplateFile.Extension)' == '.fsproj'" />
    <!-- dotnet new zerollama's Program.cs: samples/Llama.cs with a header for
         a project, made by pack.sh (in MSBuild, the text's backslashes would
         turn into slashes). -->
    <Error Condition="!Exists('$(BaseIntermediateOutputPath)zerollama/Program.cs')"
           Text="No $(BaseIntermediateOutputPath)zerollama/Program.cs: pack the templates with sdk/pack.sh." />
    <Copy SourceFiles="$(BaseIntermediateOutputPath)zerollama/Program.cs" DestinationFolder="$(ZeroContent)zerollama" />
    <!-- VS Code debugging (vscode/) in each program template's .vscode, with
         the template's project name (dotnet new renames it) and the framework,
         which names the output folder, filled in. -->
    <ItemGroup>
      <_ZeroVsCode Include="vscode/*" Template="zero" Project="ZeroApp1" />
      <_ZeroVsCode Include="vscode/*" Template="zero-fs" Project="ZeroApp1" />
      <_ZeroVsCode Include="vscode/*" Template="zerollama" Project="ZeroLlama1" />
      <_ZeroVsCode Include="vscode/*" Template="zerosdl" Project="ZeroSdl1" />
      <_ZeroVsCode Include="vscode/*" Template="zerogpu" Project="ZeroGpu1" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZeroVsCode)" DestinationFiles="@(_ZeroVsCode->'$(ZeroContent)%(Template)/.vscode/%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(ZeroContent)%(_ZeroVsCode.Template)/.vscode/%(_ZeroVsCode.Filename)%(_ZeroVsCode.Extension)"
                      Lines="$([System.IO.File]::ReadAllText('%(_ZeroVsCode.FullPath)').Replace('@ZERO_PROJECT@', '%(_ZeroVsCode.Project)').Replace('@ZERO_FRAMEWORK@', '$(ZeroFramework)'))"
                      Overwrite="true" Condition="'%(_ZeroVsCode.Filename)' == 'launch'" />
    <ItemGroup>
      <None Include="$(ZeroContent)**" Pack="true" PackagePath="content/" />
    </ItemGroup>
  </Target>
</Project>
