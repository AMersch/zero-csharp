<!-- dotnet run opens a window with a square the arrow keys move. SDL 3 comes
     with the ZeroCSharp.SDL3 package on Windows; on Linux and macOS, install
     it first: brew install sdl3 on macOS; on Linux, libsdl3-dev (Debian 13,
     Ubuntu 25.04) or SDL3-devel (Fedora 41), or build it from source
     (Ubuntu 24.04, Debian 12): see the guide.
     Guide: https://onurgumus.github.io/zero-csharp/how-to/make-a-game-window.html -->
<Project Sdk="ZeroCSharp.Sdk/@ZERO_SDK_VERSION@">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroCSharp.SDL3" Version="@ZERO_SDK_VERSION@" />
  </ItemGroup>
</Project>
