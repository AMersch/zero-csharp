{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug @ZERO_PROJECT@",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/@ZERO_FRAMEWORK@/@ZERO_PROJECT@",
      "args": [],
