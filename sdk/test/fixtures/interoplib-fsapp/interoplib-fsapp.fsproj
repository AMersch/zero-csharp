<!-- An F# program that calls fixtures/interoplib (../interoplib) through the
     F# bindings the library's build writes; it prints what
     fixtures/interoplib-app does (its expected.txt). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Native pointers. -->
    <NoWarn>$(NoWarn);9;51</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../interoplib/interoplib.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Targets="ZeroNativeLibraryFiles"
                      OutputItemType="Content" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../interoplib/bin/interoplib.Interop.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
