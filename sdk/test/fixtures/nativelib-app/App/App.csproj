<!-- An ordinary .NET program that builds a zero native library (../MathLib,
     a copy of fixtures/nativelib) first and copies it next to itself: the
     recipe docs/how-to/build-a-native-library.md gives. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- docs:build-order -->
  <ItemGroup>
    <ProjectReference Include="../MathLib/MathLib.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyMathLib" AfterTargets="Build">
    <ItemGroup>
      <MathLibNative
        Include="../MathLib/bin/$(Configuration)/zero03/native/MathLib.*" />
    </ItemGroup>
    <Copy SourceFiles="@(MathLibNative)" DestinationFolder="$(OutDir)" />
  </Target>
  <!-- docs:end -->
</Project>
