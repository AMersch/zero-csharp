<!-- An ordinary .NET program that calls a zero native library (../MathLib,
     a copy of fixtures/nativelib) through the bindings its build writes: the
     recipe docs/how-to/build-a-native-library.md gives. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- docs:reference -->
  <PropertyGroup>
    <!-- MathLib has exports that take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MathLib/MathLib.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Targets="ZeroNativeLibraryFiles"
                      OutputItemType="Content" />
    <Compile Include="../MathLib/bin/MathLib.Interop.cs" />
  </ItemGroup>
  <!-- docs:end -->
</Project>
